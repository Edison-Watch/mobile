# Release signing config for the Google Play upload key.
#
# Copy this file to `keystore.properties` (git-ignored) and fill in real values,
# OR set the equivalent ANDROID_* environment variables on a CI/release runner:
#   storeFile     -> ANDROID_KEYSTORE_FILE
#   storePassword -> ANDROID_KEYSTORE_PASSWORD
#   keyAlias      -> ANDROID_KEY_ALIAS
#   keyPassword   -> ANDROID_KEY_PASSWORD
#
# `storeFile` is resolved relative to the repository root. Never commit the
# keystore (*.jks / *.keystore) or the filled-in keystore.properties.
# See RELEASE.md for how to generate the upload keystore and build the AAB.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
