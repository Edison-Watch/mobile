<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baseline_black"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/app_name"
                android:textColor="@color/wavelength_white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_show_settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/core_cyan" />
        </LinearLayout>

        <ai.sealgate.stdiod.ui.TunnelVisualView
            android:id="@+id/tunnelVisual"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/tunnel_visual_stopped"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="@color/core_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="CONNECTED" />

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/status_indicator"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:text="@string/local_tools_label"
            android:textAllCaps="true"
            android:textColor="@color/graphene_grey"
            android:textSize="10sp" />

        <ai.sealgate.stdiod.ui.CapabilityStripView
            android:id="@+id/capabilityStrip"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/local_tools_accessibility"
            android:importantForAccessibility="yes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tunnelButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:text="@string/action_connect"
            android:textColor="@color/baseline_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/core_cyan"
            app:cornerRadius="4dp"
            app:rippleColor="@color/cyan_pressed" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/connection_settings_label"
                android:textAllCaps="true"
                android:textColor="@color/graphene_grey"
                android:textSize="10sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/gatewayUrlLayout"
                style="@style/Widget.MobileTunnel.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_gateway_url">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/gatewayUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="@color/wavelength_white"
                    android:textColorHint="@color/graphene_grey"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/apiKeyLayout"
                style="@style/Widget.MobileTunnel.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_api_key"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/apiKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/wavelength_white"
                    android:textColorHint="@color/graphene_grey"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/connectionInfoButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_connection_info"
                android:padding="12dp"
                android:src="@drawable/ic_info"
                app:tint="@color/graphene_grey" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
