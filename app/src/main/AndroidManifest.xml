<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The tunnel keeps a single outbound WebSocket open to the gateway. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Long-lived tunnel runs as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Post the ongoing "tunnel connected" notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The wifi module reads radio state, link speed, and SSID. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The bluetooth module reads adapter state and bonded devices and,
         with the control tools, connects to / scans for devices:
         legacy install-time permissions up to Android 11, the
         "Nearby devices" runtime permissions from Android 12. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- BLUETOOTH_ADMIN backs createBond() and scanning before Android 12;
         from Android 12 those are gated by the runtime permissions below. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Connect to / control paired devices (GATT, RFCOMM/SPP, pairing). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Scan for BLE peripherals (Android 12+). neverForLocation asserts we do
         not use scan results to derive physical location - we only connect to
         and control devices - so we need neither ACCESS_FINE_LOCATION nor the
         location-derivation path. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileStdiod">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TunnelService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
